    "check:envelopes": "node scripts/check-envelopes.js",
    "check:verdict-channel": "node scripts/check-verdict-channel.js"
  },
  "devDependencies": {
    "@lakatos/lemma": "0.2.1",
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "prettier": "3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
