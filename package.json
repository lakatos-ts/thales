{
  "name": "thales",
  "version": "0.0.0",
  "private": true,
  "description": "thales's TypeScript suites and check scripts; the product is the Lean package.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
